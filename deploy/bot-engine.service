[Unit]
Description=Binance USD-M Futures Bot SaaS Engine & API Server (Rust)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=botuser
Group=botuser
WorkingDirectory=/opt/bot-futures
EnvironmentFile=/opt/bot-futures/.env
ExecStart=/opt/bot-futures/bot-server

# Tự động khởi động lại nếu crash (24/7 uptime)
Restart=always
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=5

# Giới hạn tài nguyên an toàn cho VPS 1 vCPU / 2GB RAM
MemoryHigh=1024M
MemoryMax=1400M
LimitNOFILE=65535

# Hardening bảo mật cơ bản
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/bot-futures/logs

# Ghi log ra journald (xem bằng: journalctl -u bot-engine.service -f)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bot-engine

[Install]
WantedBy=multi-user.target
